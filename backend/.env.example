# ArthMitra Backend Environment Variables
# All optional — defaults to fully-local Ollama, no API keys needed.

# ── LLM provider: "ollama" (default, local/free) or "groq" (cloud, needs key) ──
LLM_PROVIDER=ollama

# ── Ollama models (must exist in `ollama list`) ──
# llama3.2:3b = 20 tok/s on RTX 2050 4GB, good finance answers + clean JSON.
# Want more quality? `ollama pull qwen3:4b` (8 tok/s, stronger) or llama3.1:8b (slower still).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_SMALL_MODEL=llama3.2:3b

# ── Groq (only used when selected in the UI) — https://console.groq.com/keys ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Tavily web search (optional, powers deep-research mode in chat) ──
TAVILY_API_KEY=
